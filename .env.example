# EstateIQ Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# ── Flask Core ─────────────────────────────────────────────
SECRET_KEY=replace-with-a-random-64-character-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database ───────────────────────────────────────────────
# SQLite (Development)
# DEV_DATABASE_URL=sqlite:///estateiq.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://estateiq_user:strongpassword@localhost/estateiq_db

# ── Advertising ────────────────────────────────────────────
ADS_ENABLED=false
ADS_PROVIDER=google_adsense
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# ── Email (optional) ───────────────────────────────────────
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
